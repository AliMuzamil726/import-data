# Copy to .env and edit. Never commit .env.
DJANGO_SECRET_KEY=change-me-to-a-50-character-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Leave DB_ENGINE=sqlite for a zero-setup local run.
# Set DB_ENGINE=postgres for the real deployment target.
DB_ENGINE=sqlite
DB_NAME=sawie
DB_USER=sawie
DB_PASSWORD=sawie
DB_HOST=localhost
DB_PORT=5432

# Leave REDIS_URL blank to use the in-memory channel layer (dev only).
REDIS_URL=

# Open-Meteo needs no key. Set a key only if you swap in a paid provider.
WEATHER_PROVIDER=open-meteo
WEATHER_API_KEY=

TIME_ZONE=Asia/Karachi
